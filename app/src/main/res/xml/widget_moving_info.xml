<?xml version="1.0" encoding="utf-8"?>
<!-- Every 30 minutes, the shortest period Android allows, plus after each read. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_moving_description"
    android:initialLayout="@layout/widget_moving"
    android:minWidth="250dp"
    android:minHeight="50dp"
    android:previewLayout="@layout/widget_moving"
    android:resizeMode="horizontal"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
